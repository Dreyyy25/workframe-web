# Base URL of the Workframe Django API (Job Board API).
#
# Dev: `.env.development` overrides this with `/api/v1` so requests go through
# the Vite proxy (same origin -> the httpOnly refresh cookie is first-party).
# Build/prod: use an absolute URL; deploy frontend and API under one domain,
# or pin CORS_ALLOWED_ORIGINS + SameSite=None; Secure on the backend.
VITE_API_BASE_URL=http://localhost:8000/api/v1
